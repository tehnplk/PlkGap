{
  "name": "plkgap",
  "version": "1.0.1",
  "description": "Electron React Vite desktop app with embedded PostGIS",
  "main": "out/main/index.js",
  "scripts": {
    "test": "npm run test:updater && npm run test:sso && npm run test:gateway && tsx scripts/test-database.ts && npm run test:indicators && node scripts/test-electron.mjs",
    "test:indicators": "tsx scripts/test-indicators.ts",
    "test:indicators:electron": "node scripts/test-indicators-electron.mjs",
    "test:gateway": "tsx scripts/test-gateway.ts",
    "test:sso": "tsx scripts/test-sso.ts",
    "dev": "node scripts/run-electron-vite.cjs dev",
    "start": "node scripts/run-electron-vite.cjs preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "test:updater": "tsx scripts/test-updater.ts",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-postgis": "^0.2.8",
    "electron-updater": "^6.8.9",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "xlsx": "^0.18.5",
    "yazl": "^3.3.1"
  },
  "private": true,
  "build": {
    "appId": "th.go.plkhealth.plkgap",
    "productName": "plkgap",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.wasm",
      "**/*.data"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tehnplk",
        "repo": "PlkGap",
        "releaseType": "draft"
      }
    ]
  }
}
